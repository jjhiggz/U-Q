		"clsx": "^2.1.1",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"effect": "3.21.3",
		"lucide-react": "1.14.0",
		"pg": "8.22.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"tailwind-merge": "3.5.0",
		"tailwindcss": "4.2.4",
		"ts-pattern": "5.9.0",
		"zod": "4.4.3"
	},
