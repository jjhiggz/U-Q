{
	"name": "uq",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun scripts/local-dev.ts dev",
		"dev:setup": "bun scripts/local-dev.ts dev:setup",
		"db:up": "bun scripts/local-dev.ts db:up",
		"db:down": "bun scripts/local-dev.ts db:down",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run --exclude '**/*.integration.test.ts' --exclude 'tests/e2e/**'",
		"test:integration": "vitest run src/features/song-queue/server/songs.repository.integration.test.ts",
		"test:e2e": "playwright test",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint . && bun run lint:custom",
		"lint:custom": "bun scripts/lint-custom.ts",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
		"typecheck": "tsgo --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun scripts/seed.ts",
		"db:seed:admin": "bun scripts/seed-admin.ts",
		"start": "bunx srvx serve --dir=.vercel/output/functions/__server.func --static=../../static --entry=index.mjs"
	},
	"dependencies": {
		"@base-ui/react": "1.4.1",
